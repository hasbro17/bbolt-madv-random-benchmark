# Shared benchmark settings, sourced by every script (VM and local).
# Values that are discovered at run time live in $BENCH_ROOT/env/*.env instead:
#   cpus.env (ETCD_CPUS, CLIENT_CPUS), cap.env (CAP_BYTES), dataset.env (golden facts),
#   versions.env (binary checksums).

BENCH_ROOT="${BENCH_ROOT:-/opt/bench}"
RESULTS_ROOT="${RESULTS_ROOT:-$BENCH_ROOT/results}"
STATE_DIR="${STATE_DIR:-$BENCH_ROOT/state}"
ENV_DIR="${ENV_DIR:-$BENCH_ROOT/env}"
VARIANTS_ROOT="${VARIANTS_ROOT:-/opt/variants}"
GOLDEN_ROOT="${GOLDEN_ROOT:-/golden}"
DATA_MOUNT="${DATA_MOUNT:-/data}"
DATA_DIR="${DATA_DIR:-$DATA_MOUNT/etcd}"
ETCD_SRC="${ETCD_SRC:-/opt/src/etcd}"

# etcd endpoints (single member, loopback only).
CLIENT_PORT="${CLIENT_PORT:-2379}"
PEER_PORT="${PEER_PORT:-2380}"
METRICS_PORT="${METRICS_PORT:-2381}"
ETCD_NAME="bench"
QUOTA_BYTES=34359738368

# Dataset shape. key-size must be 16: `benchmark stm` reads 16-byte varint keys, and
# random point reads have to hit keys that exist.
KEY_SIZE=16
VAL_SIZE=4096
GOLDEN_KEYS="${GOLDEN_KEYS:-500000}"
GOLDEN_PASSES="${GOLDEN_PASSES:-4}"   # 1 initial load + (passes-1) overwrites

# Run-time limits.
HEALTH_TIMEOUT_S="${HEALTH_TIMEOUT_S:-900}"
COMPACTION_TIMEOUT_S="${COMPACTION_TIMEOUT_S:-3600}"
MIN_FREE_DATA_GIB="${MIN_FREE_DATA_GIB:-30}"
MIN_FREE_ROOT_GIB="${MIN_FREE_ROOT_GIB:-10}"
MAX_PAIR_ATTEMPTS=3                   # 1 attempt + 2 automatic retries

# gp3 volume limits, used to flag runs where the data volume sat at its ceiling.
GP3_MAX_MIBPS=125

# Pairs per scenario (SPEC section 9). SMOKE overrides all of these to 1.
PAIRS_S3a="${PAIRS_S3a:-10}"
PAIRS_S3a_ref="${PAIRS_S3a_ref:-3}"
PAIRS_S3a_mglru_off="${PAIRS_S3a_mglru_off:-5}"
PAIRS_S3b="${PAIRS_S3b:-5}"
PAIRS_S3b_ref="${PAIRS_S3b_ref:-3}"
PAIRS_S2="${PAIRS_S2:-10}"
PAIRS_S1="${PAIRS_S1:-5}"
PAIRS_S4="${PAIRS_S4:-1}"
PAIRS_mini="${PAIRS_mini:-1}"   # tests only

# Scenario groups per VM (PLAN "VM layout").
GROUP_A="S3a S3a-ref S3a-mglru-off"
GROUP_B="S3b S3b-ref"
GROUP_C="S2"
GROUP_D="S1"
GROUP_E="S4"
